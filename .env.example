# DichTuDong - Environment Configuration
# Copy this file to .env and fill in your values

# ───── STT (Speech-to-Text) ─────
# Engine: whisper (local) | mimo (API)
STT_ENGINE=whisper

# [Whisper mode] Model: tiny/base/small/medium/large-v3
# tiny=fastest, medium=balanced, large-v3=best quality
STT_MODEL_SIZE=medium
# Device: auto/cpu/cuda
STT_DEVICE=auto
# Language: en (English source)
STT_LANGUAGE=en

# [MiMo mode] Xiaomi MiMo API Platform
# Lấy API key tại: https://platform.xiaomimimo.com/ → Console → API Keys
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-asr
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1

# ───── Translation ─────
# DeepL API key (free tier: 500K chars/month)
# Get yours at: https://www.deepl.com/pro-api
# Leave empty to use lightweight Google Translate API fallback.
DEEPL_API_KEY=
# Target language: VI (Vietnamese)
TARGET_LANG=VI

# ───── TTS (Text-to-Speech) ─────
# Enable Vietnamese voice output
TTS_ENABLED=false
# Voice options: vi-VN-HoaiMyNeural (female), vi-VN-NamMinhNeural (male)
TTS_VOICE=vi-VN-HoaiMyNeural

# ───── Server ─────
PORT=8765
HOST=0.0.0.0
LOG_LEVEL=INFO
